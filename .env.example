# Compose-level variables (read by docker-compose.yml itself, not passed into
# containers — app secrets live in backend/.env instead).

# getent group docker | cut -d: -f3
DOCKER_GID=

# docker version --format '{{.Server.APIVersion}}'
TRAEFIK_DOCKER_API_VERSION=

# Public URL the browser calls directly (client components fetch this, so it
# must be baked in at frontend build time).
NEXT_PUBLIC_API_URL=https://api.workspace.keyset.in/api

# Host-local ports nginx reverse-proxies to. Change only if something else on
# the host already uses one of these.
BACKEND_PORT=4001
FRONTEND_PORT=3005
PROXY_PORT=8091
